{
  "name": "burundi-food-price-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "dev": "node scripts/dev-stack.mjs",
    "dev:web": "npm run dev --prefix frontend",
    "dev:api": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend",
    "start": "npm start --prefix backend",
    "health:api": "node -e \"fetch('http://127.0.0.1:4000/health').then(r=>r.json()).then(console.log).catch(e=>{console.error('API down:',e.message);process.exit(1)})\"",
    "github": "git add . && git commit -m \"update: synchronisation\" && git push origin main"
  },
  "engines": {
    "node": ">=20"
  }
}
