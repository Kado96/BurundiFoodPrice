# === Render backend (secrets serveur) — même schéma que Kora Agency ===
NODE_ENV=production
PORT=4000

SUPABASE_URL=https://jvjxrknwbnsvgnobbfwa.supabase.co
# Anon JWT public — obligatoire pour requireAdmin (getUser)
SUPABASE_ANON_KEY=eyJ...anon-jwt...
# Service role (JWT legacy ou sb_secret_...) — obligatoire pour createUser / listUsers
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# À coller dans Render > Environment (service BurundiFoodPrice) :
FRONTEND_URL=https://burundi-food-price.vercel.app
CORS_ORIGIN=https://burundi-food-price.vercel.app,http://localhost:3001,http://localhost:3000
